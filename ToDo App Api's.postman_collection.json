  "item": [
    {
      "name": "Signup",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const FirstName = pm.variables.replaceIn('{{$randomFirstName}}');\r",
              "pm.environment.set(\"FirstName\", FirstName);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"check first name accuracy\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    const username= pm.environment.get(\"FirstName\");\r",
              "    pm.expect(jsonData.firstName).to.eql( username );\r",
              "\r",
              "     const Token= jsonData.access_token;\r",
              "     pm.environment.set(\"Token\", Token);\r",
              "});\r",
              "  \r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableUrlEncoding": true
      },
      "request": {
        "auth": {
          "type": "bearer"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n// use Faker method in Email, firstname, lastname\r\n    \"email\": \"{{$randomEmail}}\",\r\n    \"password\": \"Test@123\",\r\n    \"firstName\": \"{{FirstName}}\",\r\n    \"lastName\": \"{{$randomFirstName}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/v1/users/register",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add ToDo Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"verify that the Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"check the name of Todo item\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.item).to.eql(\"POSTMAN\");  \r",
              "\r",
              "    const itemID = jsonData._id;\r",
              "    pm.environment.set(\"itemID\", itemID);\r",
              "\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
